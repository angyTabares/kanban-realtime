# API
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Database (PostgreSQL en docker-compose)
# El postgres de docker-compose se publica en el host como 5433:5432 (los
# contenedores de e2e/tests ya ocupan 5432). Dentro de la red docker es 5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=kanban
DB_PASSWORD=kanban
DB_NAME=kanban_dev
DB_SYNCHRONIZE=true

# Redis (presencia en tiempo real)
# En docker-compose el redis se publica en el host como 6380:6379 (para no chocar
# con los contenedores de e2e/tests). Dentro de la red de docker sigue siendo 6379.
REDIS_HOST=localhost
REDIS_PORT=6380

# JWT
JWT_SECRET=cambia-esta-clave-en-produccion
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d